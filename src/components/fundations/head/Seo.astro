---
import { AstroSeo } from "@astrolib/seo";
---

<AstroSeo
  title="Entscheidungen Für Alle"
  description="Beratung und Begleitung um nachhaltig effizient Entscheidungen zu treffen bei denen alle mitgehen können."
  canonical="https://entscheidungenfueralle.de/current-page"
  openGraph={{
    url: "https://yoursite.com/current-page",
    title: "Entscheidungen Für Alle",
    description: "Beratung und Begleitung um nachhaltig effizient Entscheidungen zu treffen bei denen alle mitgehen können.",
    images: [
      {
        url: "https://yoursite.com/og-image.jpg",
        width: 1200,
        height: 630,
        alt: "Open Graph Image Alt",
        type: "image/jpeg",
      },
    ],
    site_name: "Entscheidungen Für Alle",
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    handle: "@yourhandle",
    site: "@yoursite",
    cardType: "summary_large_image",
  }}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://www.yourwebsite.com/" />
<meta property="og:title" content="Entscheidungen Für Alle" />
<meta
  property="og:description"
  content="Beratung und Begleitung um nachhaltig effizient Entscheidungen zu treffen bei denen alle mitgehen können."
"
/>
<meta
  property="og:image"
  content="https://www.yourwebsite.com/path/to/image.jpg"
/>

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://www.yourwebsite.com/" />
<meta property="twitter:title" content="Entscheidungen Für Alle />
<meta
  property="twitter:description"
  content="Beratung und Begleitung um nachhaltig effizient Entscheidungen zu treffen bei denen alle mitgehen können."
/>
<meta
  property="twitter:image"
  content="https://www.yourwebsite.com/path/to/image.jpg"
/>

<!-- Canonical URL -->
<link rel="canonical" href="https://www.yourwebsite.com/" />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
