---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Link from "@/components/fundations/elements/Link.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-24   lg:py-28">
      <div class="flex items-center justify-between gap-2">
        <Text
          tag="h1"
          variant="displayXL"
          data-aos="fade-down"
          data-aos-duration="1500"
          class="dark:text-white text-base-900 font-medium tracking-tighter"
        >
		Entscheidungen, <br> die für <u>alle</u> <br> funktionieren. 
      </Text>
    </div>
  </Wrapper>
  <Wrapper variant="standard">
        <div class="flex mt-4">
          <Link class="ml-auto" size="xl" variant="accent" href="https://app.formbricks.com/s/cmd74zg9b9aklys01sckpajhr"

        data-aos="fade-up"
        data-aos-duration="1000"
>
            Schreibt uns
          </Link>
        </div>
  </Wrapper>
</section>
