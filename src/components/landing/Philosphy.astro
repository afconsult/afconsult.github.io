---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Array
const philosphy = [
  {
    title: "Tauschfrei",
    description:
      "Wir arbeiten nicht für Geld, wir kommen um zu unterstützen, was uns selbst am Herzen liegt. Und wir brauchen Geld, um unseren Lebensunterhalt zu bezahlen. Vielleicht könnt und wollt ihr uns 0€ für einen Tag mit uns geben, oder vielleicht auch 8.000€ — lasst uns gemeinsam herausfinden, wie groß eure Kapazität und Bereitschaft ist, uns finanziell zu unterstützen.",
  },
  {
    title: "Lebensdienlich",
    description:
      "Uns ist wichtig, einen Beitrag zu leisten, der die Bedürfnisse aller Menschen und Lebewesen, die heute und in Zukunft auf diesem Planeten leben, berücksichtigt."
  },
  {
    title: "Explorativ",
    description:
      "Wir versuchen uns selbst und das Feld der einfühlsamen Kollaboration stetig weiterzuentwickeln. Daher sind wir besonders an Projekten interessiert, in denen wir Neues ausprobieren können, und an der Zusammenarbeit mit Menschen, die das auch wollen.",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div
      class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-4 overflow-hidden"
    >
      <Text
        tag="h3"
        variant="displayXL"
        data-aos="fade-up"
        data-aos-duration="1000"
        class="dark:text-white text-base-900 font-medium tracking-tighter text-balance"
        >Unsere Prinzipien
      </Text>
      <div
        class="flex flex-col sm:col-span-2 lg:col-span-3 divide-y divide-base-200 dark:divide-base-800 border-y border-base-200 dark:border-base-800"
      >
        {
          philosphy.map((process, index) => (
            <div class="  grid grid-cols-1 lg:grid-cols-3 py-4">
              <Text
                tag="h4"
                variant="displayXS"
                data-aos="fade-up"
                data-aos-duration="1500"
                class="dark:text-white text-base-900 font-medium tracking-tight text-balance"
              >
                {process.title}
              </Text>
              <div class="lg:col-span-2 overflow-hidden">
                <Text
                  tag="h4"
                  variant="textXL"
                  data-aos="fade-up"
                  data-aos-duration="2000"
                  class="dark:text-base-400  text-base-700  "
                >
                  {process.description}
                </Text>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
