---
// Assets
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/fundations/elements/Link.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-24 lg:pt-48">
      <div class="overflow-hidden">
        <Text
          tag="h1"
          variant="displayMD"
          data-aos="fade-down"
          data-aos-duration="1500"
          class="dark:text-white xl:text-6xl tracking-tight font-medium text-black text-balance"
        >
    	Impressum
        </Text>
      </div>

      <Text
        tag="p"
        variant="textXL"
        class="text-base-500 dark:text-base-300 lg:text-balance mt-12 md:max-w-2xl"
      >
<adress>Kirsch<br>
    c/o MDC Management#1871<br>
    Welserstraße 3<br>
    87463 Dietmannsried
</adress>
<a href='https://geschaefts-adresse-mieten.de/' style='font-size: 8pt;'>
<br>Service von geschaefts-adresse-mieten</a>
      </Wrapper>
    </section>
  </section>
</BaseLayout>
