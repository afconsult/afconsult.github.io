---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/fundations/elements/Link.astro";
import { Image } from "astro:assets";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
// Sections
import Hero from "@/components/landing/Hero.astro";
import Services from "@/components/landing/Services.astro";
import Philosphy from "@/components/landing/Philosphy.astro";
import HowWeWork from "@/components/landing/HowWeWork.astro";

// Components
import LogoCloud from "@/components/assets/LogoCloud.astro";
import WorkEntries1 from "@/components/work/WorkEntries1.astro";
import BlogEntries1 from "@/components/blog/BlogEntries1.astro";
// Content
import { getCollection } from "astro:content";
const allWork = await getCollection("work");
// Sort posts by date
const allPosts = await getCollection("posts");
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime(); // Convert to timestamp
  const dateB = new Date(b.data.pubDate).getTime(); // Convert to timestamp
  return dateB - dateA; // Compare timestamps
});
// Components
import BlogSearch from "@/components/blog/BlogSearch.astro";

import BlogEntries4 from "@/components/blog/BlogEntries4.astro";
import SubscribeCta from "@/components/blog/SubscribeCta.astro";
// Content
// Team
import One from "@/images/team/alex.png";
import Two from "@/images/team/fabian.webp";
import Three from "@/images/team/roni-1536x864.webp";
import Four from "@/images/team/4.jpeg";
import Five from "@/images/team/5.jpeg";
import Six from "@/images/team/6.jpeg";
import ISCLogo from "@/images/isc-logo.png";
const teamMembers = [
  {
    name: "Alexander Koch",
    role: "Facilitator & Systementwickler",
    image: One,
    bio: "Mit einem Hintegrund in Mathemaitsche Physik und jahrer langer Aktivistischer erfahrung bringt Alexander seinen Anlytischen Geist und Geselschaftliche Perspektive zusammen mit einer Tiefen spirituellen haltung dem Leben gegenüber zu seiner Arbeit mit Organisationen.",
  },
  {
    name: "Fabian Kirsch",
    role: "Facilitator & Systementwickler",
    image: Two,
    bio: "Yuki specializes in typography and layout, ensuring every design is both visually striking and meaningful.",
  },
  {
    name: "Roni Wiener",
    role: "Advisor — Integration Station Collective",
    image: Three,
    bio: "Souta blends market insights with creative vision to develop brands that connect deeply with their audiences.",
  },
];
---


<BaseLayout>
  <Hero />
<!---  <LogoCloud /> --->
  <section>
    <Wrapper variant="standard" class="py-24 lg:pt-48">
      <div class="flex items-center justify-between gap-2">
        <Text
          tag="h1"
          variant="displayXL"
          data-aos="fade-up"
          data-aos-duration="1000"
          class="dark:text-white text-base-900 font-medium tracking-tighter"
        >
          Wie wir dabei helfen
        </Text>
      </div>
      <div
        class="flex flex-col divide-y divide-base-200 dark:divide-base-800 border-y border-base-200 dark:border-base-800 mt-4"
      >
        {allPosts.map((post) => <BlogEntries4 post={post} />)}
      </div>
    </Wrapper>
  </section>
  <Philosphy />
  <section>
    <Wrapper variant="standard" class="py-24">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4">
        <Text
          tag="h3"
          variant="displayXL"
          data-aos="fade-up"
          data-aos-duration="1000"
          class="dark:text-white text-base-900 font-medium tracking-tighter"
          >Wir
          <br />
          sind
        </Text>

        <div
          class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-3 gap-y-12 gap-2 lg:col-span-3"
        >
          {
            teamMembers.map((member, index) => (
              <div class="flex flex-col ">
                <Image
                  width={500}
                  height={500}
                  src={member.image}
                  alt={member.name}
                  class="w-full  object-cover"
                />
                <div class="mt-2">
                  <Text
                    tag="h3"
                    variant="textBase"
                    class="leading-6 text-base-900 dark:text-white"
                    data-aos="fade-up"
                    data-aos-duration="1000"
                  >
                  
                    {member.name}
                  </Text>
                  <Text
                    tag="p"
                    variant="textSM"
                    class="text-base-500 dark:text-base-400"
                    data-aos="fade-up"
                    data-aos-duration="1000"
                  >
                    {member.role}
                  </Text>
                  <Text
                    tag="p"
                    variant="textSM"
                    class="text-base-500 mt-4 dark:text-base-400"
                    data-aos="fade-up"
                    data-aos-duration="1000"
                  >
                    {member.bio}
                  </Text>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </Wrapper>
    <section>
      <Wrapper variant="standard" class="py-12">
        <Text
          tag="h3"
          variant="displayMD"
          class="dark:text-white xl:text-7xl tracking-tight font-medium text-black text-balance lg:col-span-3"
        >
          Ihr wollt gerne mit uns arbeiten? 
        </Text>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-2">
        <div class="py-4 mr-auto ml-auto mt-auto mb-auto">
          <Text
            tag="p"
            variant="textXS"
            class="text-base-900 dark:text-white uppercase font-medium"
          >
            Wir arbeiten in Partnerschaft mit dem <br>
            <a href="https://decisionsforall.org"><u>Integration Station Collective</u></a>
          </Text>
          <Image
                  width={300}
				  href="https://decisionsforall.org"
                  height={300}
                  src={ISCLogo}
                  alt="integration station collective logo"
                />
        </div>
        <div class="py-4 mr-auto ml-auto mt-auto mb-auto">
          <Text
            tag="p"
            variant="textXS"
            class="text-base-900 dark:text-white uppercase font-medium"
          >
          </Text>
          <div class="mt-4 flex flex-col gap-4">
        <div class="flex mt-4">
          <Link size="xl" variant="accent" href="https://app.formbricks.com/s/cmd74zg9b9aklys01sckpajhr"

        data-aos="fade-up"
        data-aos-duration="1000"
>
            Schreibt uns
          </Link>
        </div>
          </div>
        </div>
        </Text>
      </Wrapper>
      </Wrapper>
    </section>
  </section>
  <HowWeWork />
</BaseLayout>
